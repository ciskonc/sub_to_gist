# =============================================================================
# sub_to_gist — 全局配置文件模板
#
# 部署时复制到 /etc/sub_to_gist/config.conf 并填入真实值
# 文件格式：KEY="VALUE"（仅允许此格式，禁止 source）
# 文件权限：必须 chmod 600
# =============================================================================

# GitHub Personal Access Token（必填）
# 生成地址：https://github.com/settings/tokens
# 要求：fine-grained PAT，仅 gist 权限，90 天过期
# 格式：ghp_xxxxxxxxxxxx（classic PAT）或 github_pat_xxxxxxxxxxxx（fine-grained PAT）
GIST_TOKEN="ghp_REPLACE_WITH_YOUR_TOKEN"

# Gist description 前缀（可选，默认 sub_to_gist）
# 用于在 GitHub Gist 列表中标识本工具创建的 gist
GIST_DESCRIPTION_PREFIX="sub_to_gist"

# =============================================================================
# 以下为任务配置示例（实际任务配置存放在 tasks.d/{task_id}.conf）
# =============================================================================
#
# 任务配置文件格式（每个 .conf 文件一个任务）：
#
#   TASK_NAME="机场A"
#   TASK_URL="https://example.com/sub?token=xxx"
#   TASK_UA="Mozilla/5.0 (Windows NT 10.0; Win64; x64)"
#   TASK_HEADERS="X-Custom-Header: value|X-Another: value2"
#   TASK_GIST_ID=""
#   TASK_GIST_FILENAME="airport_a.txt"
#
# 字段说明：
#   TASK_NAME          任务显示名称（用于菜单和日志，不允许特殊字符）
#   TASK_URL           订阅地址（必须以 https:// 开头）
#   TASK_UA            自定义 User-Agent（留空使用 curl 默认 UA）
#   TASK_HEADERS       额外请求头（格式：Key: Value|Key2: Value2，留空跳过）
#   TASK_GIST_ID       Gist ID（首次推送后自动填入，勿手动修改）
#   TASK_GIST_FILENAME Gist 中的文件名（默认为 {task_id}.txt）
#
# 任务 ID 命名规则：
#   - 仅允许小写字母 / 数字 / 下划线
#   - 必须以字母开头
#   - 最长 32 字符
#   - 示例：airport_a / vpn_proxy / sub_001
